rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function volunteer() {
      return signedIn() && request.auth.token.email.matches('^ruta-([1-9])@voluntarios\\.bokatas\\.local$');
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsResource() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /userProfiles/{userId} {
      allow get: if ownsProfile(userId);
      allow create: if ownsProfile(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'collaborator'
        && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'email', 'createdAt', 'updatedAt']);
      allow update: if ownsProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == 'collaborator'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'email', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow get, list: if resource.data.status == 'published' || ownsResource() || volunteer();
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow get, list: if ownsResource() || volunteer();
        allow create, update, delete: if false;
      }
    }

    match /catalogConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /routesConfig/{routeId} {
      allow read, write: if volunteer() && request.auth.token.email.matches('^' + routeId + '@voluntarios\\.bokatas\\.local$');
    }

    match /routeSupplyWeeks/{docId} {
      allow read: if volunteer();
      allow write: if volunteer()
        && request.resource.data.routeId is string
        && request.resource.data.weekKey is string
        && request.resource.data.routeId.matches('^ruta-([1-9])$')
        && docId.matches('^' + request.resource.data.routeId + '_[0-9]{4}-W[0-9]{2}$')
        && request.auth.token.email.matches('^' + request.resource.data.routeId + '@voluntarios\\.bokatas\\.local$');
    }

    match /supplyRules/{ruleId} {
      allow read: if volunteer();
      allow write: if false;
    }

    match /resourceOverrides/{resourceId} {
      allow read: if volunteer();
      allow write: if false;
    }
  }
}
