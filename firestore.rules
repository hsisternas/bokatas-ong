rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^ruta-(10|[1-9])@voluntarios\\.bokatas\\.local$');
    }

    match /resourceOverrides/{resourceId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^ruta-(10|[1-9])@voluntarios\\.bokatas\\.local$');
    }
  }
}
