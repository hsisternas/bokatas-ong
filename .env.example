# Backend endpoint (safe to expose)
VITE_ASSISTANT_API_URL=/api/assistant

# Firebase Web config (public, but required)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Google Maps JavaScript API key.
# This key is public in browser apps, so protect it with strict HTTP referrer + API restrictions.
VITE_GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_MAPS_BROWSER_KEY
